📋 CopyDashboardLinkButton.tsx
import { useState } from "react";

type CopyDashboardLinkButtonProps = {
  dashboardName: string;
  url?: string;          // אם לא מועבר – נשתמש ב־location.href
  className?: string;
};

export const CopyDashboardLinkButton = ({
  dashboardName,
  url,
  className,
}: CopyDashboardLinkButtonProps) => {
  const [copied, setCopied] = useState(false);

  const copyLink = async () => {
    const link = url ?? window.location.href;

    try {
      await navigator.clipboard.write([
        new ClipboardItem({
          "text/plain": new Blob([link], { type: "text/plain" }),
          "text/html": new Blob(
            [`<a href="${link}">${dashboardName}</a>`],
            { type: "text/html" }
          ),
        }),
      ]);
    } catch {
      // fallback לדפדפנים ישנים
      await navigator.clipboard.writeText(`${dashboardName}\n${link}`);
    }

    setCopied(true);
    setTimeout(() => setCopied(false), 1500);
  };

  return (
    <button
      type="button"
      onClick={copyLink}
      className={className}
      aria-label="Copy dashboard link"
      title="Copy dashboard link"
    >
      {copied ? "✔ Copied" : "🔗 Copy link"}
    </button>
  );
};

